{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XIVLegacy/xivl-opcodes/schemas/retail-evidence-attestation-v1.schema.json",
  "title": "Retail evidence verification attestation, version 1",
  "description": "Strict sanitized output of a public retail-input verification check. Observation rows and diagnostics are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicRepositoryCommit",
    "approvedInputSha256",
    "toolVersions",
    "check",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "publicRepositoryCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "approvedInputSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ghidra", "jdk", "verifier"],
      "properties": {
        "ghidra": {
          "const": "12.1.3"
        },
        "jdk": {
          "const": "21.0.12.1+1"
        },
        "verifier": {
          "const": "1.0"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "const": "zone-dispatch-0x018d-slot-v1"
        },
        "version": {
          "const": 1
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["pass", "fail"]
        }
      }
    }
  }
}
